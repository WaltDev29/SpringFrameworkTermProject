# ==========================================
# AquaMate Docker Compose Environment Variables (Example)
# 이 파일을 복사하여 .env 로 이름을 변경한 후 실제 비밀번호를 설정하세요.
# ==========================================

# MySQL Root Password (강력한 무작위 비밀번호 권장)
MYSQL_ROOT_PASSWORD=your_secure_root_password_here

# AquaMate Database Configuration
MYSQL_DATABASE=aquamate
MYSQL_USER=aquamate
MYSQL_PASSWORD=your_secure_db_password_here

# Port Mapping (호스트 포트 충돌 방지용)
MYSQL_PORT=3307
APP_PORT=8005
